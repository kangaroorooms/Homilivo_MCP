# Generated by the code, never committed. Patterns are relative to this folder, so they cover a server started with
# llm_approach/ as the working directory. The default Chroma folder when started from the REPO ROOT is the root
# data/chroma_v2/, which only the root .gitignore can cover.

# Knowledge-base index (LLM_APPROACH_CHROMA_PERSIST_DIR default data/chroma_v2), its build lock and document fingerprint
data/
.ingest.lock
doc_fingerprint.txt

# Gemini request counter: the file, its atomic-write temp files and the startup write probe
gemini_requests.json
gemini_requests.json.*

# Per-turn metric lines (LLM_APPROACH_METRICS=1)
metrics.jsonl
