    {
      "user": "koramangala",
      "llm": {
        "intent": "REFINEMENT",
        "confidence": 0.95,
        "slots": {
          "area": "Koramangala"
        }
      },
      "expect": {
        "intent": "REFINEMENT",
        "action": "refinement",
