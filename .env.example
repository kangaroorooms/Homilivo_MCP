# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Every variable below is read somewhere in app/; none of these reach the
# browser/client (see app/server.py's per-request ContextVar token binding).

# ------------------------------------------------------------
# Homilivo API credential
# ------------------------------------------------------------
# REQUIRED: the app refuses to start without it (validate_secrets() in
# app/api.py, P3-13). It is also the server-side fallback credential for
# the CLI debug tool (app/agent.py, `python -m app.agent`) and the
# /chat-ui demo page's opaque short-lived demo-token exchange
# (app/demo_auth.py) so a presenter never has to paste a real token into
# the browser. /chat callers still supply their own bearer token (BYOT).
KANGAROO_TOKEN=your_kangaroo_token_here

# ------------------------------------------------------------
# LLM (GROQ mode)
# ------------------------------------------------------------
# Optional: only needed for mode="groq" in /chat or /ws/chat. Startup logs
# a warning if unset; fast/qwen/gemma modes do not need it.
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------
# Voice input (Deepgram)
# ------------------------------------------------------------
# Optional. Used only by the frontend demo (frontend-demo/src/useDeepgram.ts),
# not read by app/. Placeholder only - never commit a real key.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------
# Homilivo outbound API reliability (app/server.py)
# ------------------------------------------------------------
HOMILIVO_API_TIMEOUT_SECONDS=10
HOMILIVO_API_MAX_ATTEMPTS=3
HOMILIVO_API_RETRY_BACKOFF_SECONDS=0.3

# ------------------------------------------------------------
# Subscription pricing API (app/experiments/agent_modes.py)
# ------------------------------------------------------------
PRICING_API_URL=https://kangaroo-rooms-backend.onrender.com/api/tenant-subscriptions/pricing

# ------------------------------------------------------------
# Rate limiting (app/rate_limit.py)
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# Session store (app/session_store.py)
# ------------------------------------------------------------
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=1000
SESSION_MAX_HISTORY_MESSAGES=40

# ------------------------------------------------------------
# WebSocket streaming (app/api.py)
# ------------------------------------------------------------
STREAM_CHUNK_DELAY_SECONDS=0.02
WS_HEARTBEAT_INTERVAL_SECONDS=20

# ------------------------------------------------------------
# Feedback storage (app/feedback_store.py)
# ------------------------------------------------------------
# Local append-only JSONL file path. No new infra required.
FEEDBACK_LOG_PATH=data/feedback.jsonl

# ------------------------------------------------------------
# State backend (app/session_store.py, app/rate_limit.py,
# app/demo_auth.py)
# ------------------------------------------------------------
# memory (default): each of the four state stores - sessions, the
# rate limiter, demo-auth tokens, and the conversation memory a
# session carries for follow-ups - lives in this process only. Fine
# for a single-process deployment; nothing below is required.
#
# redis: all four are backed by Redis instead, so multiple app
# instances behind a load balancer share sessions, a rate-limit
# budget, and demo tokens. Requires a reachable Redis - see
# docker-compose.yml (`docker compose up -d redis`) for a local one,
# or point REDIS_URL at an existing instance.
STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Knowledge base / RAG (app/knowledge/store.py)
# ------------------------------------------------------------
# Where the embedded (in-process, no separate server) Chroma
# collection persists its index. Relative paths resolve against the
# working directory the app is started from. Safe to delete this
# directory any time - app.knowledge.ingest / warmup() rebuild it from
# app/knowledge/documents/*.md.
CHROMA_PERSIST_DIR=data/chroma

# ------------------------------------------------------------
# Cost / model-tier controls (Phase 8, app/observability.py)
# ------------------------------------------------------------
# Optional $/1K-token rates used ONLY to compute an ESTIMATED cost
# figure surfaced at GET /metrics ("llm_usage") - never a substitute
# for a provider's real invoice, and never guessed at by this project
# (see docs/Homilivo_Project_Plan.md guardrail #10). Leave unset (or 0)
# for locally-hosted modes (qwen/gemma via Ollama), which have no
# real per-token cost. Set LLM_COST_PER_1K_TOKENS_GROQ if you want a
# rough running cost estimate for the hosted GROQ mode - check Groq's
# own pricing page for the current rate for GROQ_MODEL.
LLM_COST_PER_1K_TOKENS_QWEN=0
LLM_COST_PER_1K_TOKENS_GEMMA=0
LLM_COST_PER_1K_TOKENS_GROQ=0
