{
  "id": "S24",
  "title": "Regression: Groq rate limit runs the rule-based fallback, rooms on screen are kept",
  "turns": [
    {
      "user": "rooms in bangalore",
      "llm": {
        "intent": "NEW_SEARCH",
        "confidence": 0.95,
        "slots": {
          "city": "Bangalore"
        },
        "standalone_query": "find rooms in Bangalore"
      },
      "expect": {
        "intent": "NEW_SEARCH",
        "action": "new_search",
        "tool_called": true,
        "rooms_on_screen": 10
      }
    },
    {
      "user": "which one is cheapest",
      "llm": "rate_limit",
      "expect": {
        "action": "fallback_ask",
        "error_class": "RateLimitError",
        "tool_called": false,
        "fallback_used": true,
        "rooms_on_screen": 10,
        "reply_contains": [
          "search again"
        ],
        "reply_not_contains": [
          "Which city"
        ]
      }
    },
    {
      "user": "which one is cheapest",
      "llm": {
        "intent": "ROOM_FOLLOWUP",
        "operation": "LOWEST_PRICE",
        "confidence": 0.95
      },
      "expect": {
        "intent": "ROOM_FOLLOWUP",
        "operation": "LOWEST_PRICE",
        "tool_called": false,
        "rooms_on_screen": 10
      }
    }
  ]
}
