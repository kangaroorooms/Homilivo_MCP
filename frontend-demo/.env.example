# Copy this file to .env and fill in real values. Never commit .env.

# Base HTTP(S) URL of the Homilivo chatbot backend (app/api.py).
# The WebSocket URL is derived from this (http->ws, https->wss),
# per docs/WEBSOCKET_CONTRACT.md §1.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Token sent as ?token=<token> on the WebSocket connect (contract §1) and
# as "Authorization: Bearer <token>" on the REST /chat fallback (contract
# §6). Use a demo token here (GET /chat-ui/demo-token, if the server has a
# server-side credential configured) rather than a real Homilivo API token.
VITE_DEMO_TOKEN=replace-with-a-demo-or-real-token
