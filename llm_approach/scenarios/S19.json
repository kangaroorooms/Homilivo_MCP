{
  "id": "S19",
  "title": "Area reply to the area question searches instead of repeating it",
  "turns": [
    {
      "user": "rooms in bangalore",
      "llm": {
        "intent": "NEW_SEARCH",
        "confidence": 0.95,
        "slots": {
