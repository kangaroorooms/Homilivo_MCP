{
  "id": "S22",
  "title": "A budget refinement keeps the area; a new city with filters on screen asks (D4) and does not search yet",
  "turns": [
    {
      "user": "rooms in bangalore",
      "llm": {
        "intent": "NEW_SEARCH",
        "confidence": 0.95,
        "slots": {
          "city": "Bangalore"
        },
        "standalone_query": "find rooms in Bangalore"
      },
      "expect": {
        "intent": "NEW_SEARCH",
        "action": "new_search",
        "tool_called": true,
        "rooms_on_screen": 10,
        "search": {
          "city": "Bangalore"
        }
      }
    },
    {
      "user": "koramangala",
      "llm": {
        "intent": "REFINEMENT",
        "confidence": 0.95,
        "slots": {
          "area": "Koramangala"
        }
      },
      "expect": {
        "intent": "REFINEMENT",
        "action": "refinement",
        "tool_called": true,
        "rooms_on_screen": 9,
        "search": {
          "city": "Bangalore",
          "area": "Koramangala"
        }
      }
    },
    {
      "user": "under 15k",
      "llm": {
        "intent": "REFINEMENT",
        "confidence": 0.95,
        "slots": {
          "max_price": 15000
        }
      },
      "expect": {
        "intent": "REFINEMENT",
        "action": "refinement",
        "tool_called": true,
        "search": {
          "city": "Bangalore",
          "area": "Koramangala",
          "max_price": 15000
        },
        "reply_contains": [
          "Koramangala, Bangalore"
        ]
      }
    },
    {
      "user": "in pune",
      "llm": {
        "intent": "REFINEMENT",
        "confidence": 0.95,
        "slots": {
          "city": "Pune"
        }
      },
      "expect": {
        "intent": "REFINEMENT",
        "action": "ask_city_change",
        "tool_called": false,
        "pending": "city_change",
        "reply_contains": [
          "You were looking at rooms in Bangalore under ₹15,000",
          "same filters",
          "start a new search for Pune"
        ]
      }
    }
  ]
}
