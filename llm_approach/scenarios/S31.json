{
  "id": "S31",
  "title": "Session memory: first query is the first user message",
  "turns": [
    {
      "user": "2 BHK in Bangalore",
      "llm": {
        "intent": "NEW_SEARCH",
        "confidence": 0.95,
        "slots": {
          "city": "Bangalore"
